# ── Google Gemini (free at https://ai.google.dev — no credit card needed) ─────
GEMINI_API_KEY=YOUR_GEMENI_KEY

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=site_ops_intel

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=Random_series_of_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── YOLO Models (your actual trained weights) ─────────────────────────────────
MODEL_BASE=~/gate-monitor/yolov8n.pt
MODEL_BOX=~/gate-monitor/runs/detect/gate1_box/weights/best.pt
MODEL_BARREL=~/gate-monitor/runs/detect/gate3_barrel4/weights/best.pt

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
